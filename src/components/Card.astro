---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";
import GameCard from "@components/GameCard.astro";

export interface Props {
  // Use the built-in Astro type for blog data
  data: CollectionEntry<"blog">["data"];
  id: string;
  filePath?: string;
  variant?: "h2" | "h3";
}

const { variant = "h2", data, id, filePath } = Astro.props;

// Destructure from the 'data' prop we just received
const {
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  games,
  currentScore,
  finalScore,
  type,
} = data;

const isReview = type === "review";
const gameSlug = games && games.length > 0 ? slugifyStr(games[0]) : null;
const coverImage = `/raxplays/assets/reviews/${gameSlug}.jpg`;

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class: "text-lg font-medium decoration-dashed hover:underline",
};

// --- Movement Logic ---
let movement = null;

if (currentScore && games && games.length > 0) {
  const subjectGame = games[0];

  // Look through the whole blog to find other posts with this game
  const allRelated = await getCollection(
    "blog",
    post =>
      post.data.games?.includes(subjectGame) &&
      post.data.currentScore !== undefined
  );

  if (allRelated.length > 1) {
    const sorted = allRelated.sort(
      (a, b) => a.data.pubDatetime.valueOf() - b.data.pubDatetime.valueOf()
    );

    const initialScore = sorted[0].data.currentScore ?? 0;

    if (currentScore > initialScore) movement = "up";
    if (currentScore < initialScore) movement = "down";
    if (currentScore == initialScore) movement = "same";
  }
}
---

{
  isReview ? (
    /* --- REVIEW STYLE CARD --- */
    <li class="review-card-item my-8">
      <a href={getPath(id, filePath)} class="review-card-link group">
        <div
          class="review-card-bg"
          style={`background-image: url(${coverImage})`}
        >
          <div class="review-card-overlay">
            <div class="review-card-content">
              <span class="review-badge">My Verdict</span>
              <h2 class="review-title">{title}</h2>
              <p class="review-desc">{description}</p>

              <div class="review-footer">
                <div class="final-score-circle">{finalScore?.toFixed(1)}</div>
                <span class="read-more">Read Full Review →</span>
              </div>
            </div>
          </div>
        </div>
      </a>
    </li>
  ) : (
    <li class="my-6">
      <a
        href={getPath(id, filePath)}
        class="inline-block text-lg font-medium text-accent decoration-dashed underline-offset-4 focus-visible:no-underline focus-visible:underline-offset-0"
      >
        {variant === "h2" ? (
          <h2 {...headerProps}>
            {title}
            {currentScore && (
              <span class="ml-3 inline-block rounded border border-accent bg-transparent px-2 py-0.5 align-middle text-sm font-bold text-accent">
                {currentScore.toFixed(1)}
                {movement === "up" && (
                  <span class="ml-1 text-green-500">↑</span>
                )}
                {movement === "down" && (
                  <span class="ml-1 text-red-500">↓</span>
                )}
                {movement === "same" && <span class="ml-1">-</span>}
              </span>
            )}
          </h2>
        ) : (
          <h3 {...headerProps}>
            {title}
            {currentScore && (
              <span class="ml-3 inline-block rounded border border-accent bg-transparent px-2 py-0.5 align-middle text-sm font-bold text-accent">
                {currentScore.toFixed(1)}
                {movement === "up" && (
                  <span class="ml-1 text-green-500">↑</span>
                )}
                {movement === "down" && (
                  <span class="ml-1 text-red-500">↓</span>
                )}
                {movement === "same" && <span class="ml-1">-</span>}
              </span>
            )}
          </h3>
        )}
      </a>
      <Datetime {pubDatetime} {modDatetime} {timezone} />
      <p>{description}</p>

      <div class="not-prose mt-4 w-full">
        {games && games.length > 0 && (
          <ul class="!m-0 grid list-none grid-cols-8 gap-4 !p-0 sm:grid-cols-3 md:grid-cols-8">
            {games.map(game => (
              <GameCard
                name={game}
                slug={slugifyStr(game)}
                image={`/assets/games/${slugifyStr(game)}.jpg`}
              />
            ))}
          </ul>
        )}
      </div>
    </li>
  )
}

<style>
  /* Review Card Styles */
  .review-card-item {
    list-style: none;
  }
  .review-card-link {
    display: block;
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none !important;
    border: 1px solid var(--color-border);
    transition: transform 0.3s ease;
  }
  .review-card-link:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }
  .review-card-bg {
    background-size: cover;
    background-position: center;
    min-height: 280px;
    display: flex;
  }
  .review-card-overlay {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 1.5rem;
    background: linear-gradient(
      to right,
      rgba(var(--color-fill-rgb), 0.8) 0%,
      transparent 100%
    );
  }
  .review-card-content {
    max-width: 70%;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 1.5rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
  }
  .review-badge {
    display: inline-block;
    background: #ffffff;
    color: var(--color-fill);
    font-size: 0.7rem;
    font-weight: 900;
    padding: 0.2rem 0.6rem;
    border-radius: 0.25rem;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .review-title {
    color: #1a1a1a !important; /* Fixed dark gray/black */
    font-size: 1.5rem !important;
    font-weight: 900;
    margin-bottom: 0.5rem;
  }

  .review-desc {
    color: #4a4a4a !important; /* Fixed medium gray */
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .review-footer {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .final-score-circle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 3px solid var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1.2rem;
    color: var(--color-accent);
    background: var(--color-fill);
  }
  .read-more {
    font-size: 0.8rem;
    font-weight: bold;
    color: var(--color-accent);
  }

  /* Mobile Adjustments */
  @media (max-width: 640px) {
    .review-card-overlay {
      background: rgba(0, 0, 0, 0.2); /* Darken slightly for mobile contrast */
      justify-content: center;
      align-items: center;
    }
    .review-card-content {
      max-width: 95%;
      padding: 1.25rem;
    }
  }
</style>
