---
import { getCollection } from "astro:content";
import { getPath } from "@/utils/getPath";

interface Props {
  gameName: string;
  finalScore: number;
}

const { gameName, finalScore } = Astro.props;

const allMentions = await getCollection("blog", ({ data }) => 
  data.games?.includes(gameName)
);

// Sort by date to build the timeline
const sortedMentions = allMentions.sort((a, b) => 
  a.data.pubDatetime.valueOf() - b.data.pubDatetime.valueOf()
);

const totalMentions = allMentions.length;
const firstPlayed = sortedMentions[0].data.pubDatetime;
---

<div class="review-meta-box">
  <div class="stats-grid">
    <div class="stat-item">
      <span class="stat-label">Total Mentions</span>
      <span class="stat-value">{totalMentions}</span>
    </div>
    <div class="stat-item">
      <span class="stat-label">First Impression</span>
      <span class="stat-value">{firstPlayed.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</span>
    </div>
    <div class="stat-item highlight">
      <span class="stat-label">Final Verdict</span>
      <span class="stat-value">{finalScore.toFixed(1)}</span>
    </div>
  </div>

  <div class="timeline-container">
    <h4>Review Timeline</h4>
    <div class="timeline">
      {sortedMentions.map((post) => (
        <a href={getPath(post.id)} class="timeline-node group">
          <span class="node-dot"></span>
          <div class="node-content">
            <span class="node-date">{post.data.pubDatetime.toLocaleDateString('en-GB', { month: 'short', year: '2-digit' })}</span>
            <span class="node-score">{post.data.currentScore ? post.data.currentScore.toFixed(1) : '—'}</span>
          </div>
          <div class="node-tooltip">{post.data.title}</div>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  .review-meta-box {
    @apply my-8 rounded-xl border-2 border-accent/30 bg-accent/5 p-6;
  }
  .stats-grid {
    @apply grid grid-cols-3 gap-4 border-b border-accent/20 pb-6 mb-6;
  }
  .stat-item {
    @apply flex flex-col items-center text-center;
  }
  .stat-label {
    @apply text-[10px] uppercase tracking-tighter opacity-70;
  }
  .stat-value {
    @apply text-2xl font-black text-accent;
  }
  .highlight .stat-value {
    @apply text-4xl scale-110;
  }

  /* Timeline Styling */
  .timeline-container h4 {
    @apply text-xs uppercase tracking-widest mb-4 opacity-80 font-bold;
  }
  .timeline {
    @apply flex items-center gap-2 overflow-x-auto pb-4;
  }
  .timeline-node {
    @apply relative flex flex-col items-center min-w-[60px] no-underline transition-transform hover:-translate-y-1;
  }
  .node-dot {
    @apply w-3 h-3 rounded-full bg-accent mb-2 border-2 border-fill;
  }
  .node-content {
    @apply flex flex-col items-center bg-accent/10 rounded px-2 py-1;
  }
  .node-date {
    @apply text-[9px] opacity-70;
  }
  .node-score {
    @apply text-xs font-bold;
  }
  .node-tooltip {
    @apply absolute -top-8 hidden group-hover:block bg-skin-card border border-accent text-[10px] px-2 py-1 whitespace-nowrap rounded shadow-xl z-10;
  }
</style>