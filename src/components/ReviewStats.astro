---
import { getCollection } from "astro:content";
import { getPath } from "@/utils/getPath";

interface Props {
  gameName: string;
  finalScore: number;
}

const { gameName, finalScore } = Astro.props;

const currentPath = Astro.url.pathname;

const allMentions = await getCollection("blog", ({ data }) =>
  data.games?.includes(gameName)
);

const sortedMentions = allMentions.sort(
  (a, b) => a.data.pubDatetime.valueOf() - b.data.pubDatetime.valueOf()
);

const totalMentions = allMentions.length;
const firstPlayed = sortedMentions[0].data.pubDatetime;
---

<div class="review-meta-box">
  <div class="stats-grid">
    <div class="stat-item">
      <span class="stat-label">Total Mentions</span>
      <span class="stat-value">{totalMentions}</span>
    </div>
    <div class="stat-item">
      <span class="stat-label">First Impression</span>
      <span class="stat-value"
        >{
          firstPlayed.toLocaleDateString("en-GB", {
            month: "short",
            year: "numeric",
          })
        }</span
      >
    </div>
    <div class="stat-item highlight">
      <span class="stat-label">Final Verdict</span>
      <span class="stat-value">{finalScore.toFixed(1)}</span>
    </div>
  </div>

  <div class="timeline-container">
    <h4>Review History</h4>
    <div class="timeline-wrapper">
      <div class="timeline">
        {
          sortedMentions.map(post => {
            const postPath = getPath(post.id, post.filePath);
            const isFinal =
              postPath === currentPath || post.data.type === "review";

            return (
              <a
                href={postPath}
                class:list={["timeline-node", { "is-final": isFinal }]}
              >
                <div class="node-content">
                  {isFinal && <span class="final-badge">Verdict</span>}
                  <span class="node-title">{post.data.title}</span>
                  <div class="node-meta">
                    <span class="node-date">
                      {post.data.pubDatetime.toLocaleDateString("en-GB", {
                        month: "short",
                        year: "2-digit",
                      })}
                    </span>
                    <span class="node-score">
                      {post.data.currentScore?.toFixed(1) ?? "—"}
                    </span>
                  </div>
                </div>
                <span class="node-dot" />
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</div>

<style>
  .timeline-node.is-final .node-content {
    border: 2px solid var(--color-accent);
    background-color: #ffffff;
    box-shadow: 0 0 15px rgba(var(--color-accent-rgb), 0.2);
  }

  .timeline-node.is-final .node-dot {
    transform: scale(1.3);
    box-shadow:
      0 0 0 3px var(--color-card),
      0 0 0 5px var(--color-accent);
  }

  .final-badge {
    font-size: 0.5rem;
    text-transform: uppercase;
    background: #00c8c8;
    color: var(--color-card);
    padding: 0.1rem 0.4rem;
    border-radius: 99px;
    font-weight: 900;
    width: fit-content;
    margin: 0 auto 0.25rem auto;
    letter-spacing: 0.05em;
  }

  /* Ensure the triangle on the final node matches the thicker border */
  .timeline-node.is-final .node-content::after {
    border-top-color: var(--color-accent);
    bottom: -8px; /* Offset for 2px border */
  }
  .review-meta-box {
    position: relative;
    z-index: 10; /* Create a new base layer */
    margin: 2rem 0;
    border: 1px solid var(--color-accent);
    /* background-color: var(--color-card); */
    background-color: #f5f5f5;
    padding: 1.5rem;
    border-radius: 0.75rem;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
    font-weight: bold;
  }
  .stat-value {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-accent);
  }
  .highlight .stat-value {
    font-size: 2.5rem;
    line-height: 1;
  }

  .timeline-container h4 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    opacity: 0.8;
    color: var(--color-accent);
  }

  .timeline-wrapper {
    overflow-x: auto;
    padding: 0 0.5rem 1rem 0.5rem; /* Extra top padding for the boxes */
    scrollbar-width: thin;
    scrollbar-color: var(--color-accent) transparent;
    position: relative;
  }

  .timeline {
    display: flex;
    align-items: flex-end;
    gap: 2rem; /* Increased gap to prevent box overlap */
    min-width: max-content;
    position: relative;
  }

  /* The Connecting Line */
  .timeline::before {
    content: "";
    position: absolute;
    bottom: 5px; /* Aligns with the center of the 0.6rem dots */
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    opacity: 0.3;
    z-index: 1;
  }

  .timeline-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    width: 130px; /* Fixed width for consistency */
    position: relative;
    z-index: 2; /* Sits above the connecting line */
    transition: transform 0.2s ease;
  }

  .timeline-node:hover {
    transform: translateY(-2px);
  }

  .node-content {
    background-color: #ffffff;
    border: 1px solid var(--color-accent);
    padding: 0.6rem;
    border-radius: 0.5rem;
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: center;
    position: relative;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  /* Triangle pointer */
  .node-content::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid var(--color-accent);
  }

  .node-title {
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text-base);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .node-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    padding-top: 0.25rem;
    border-top: 1px solid rgba(var(--color-accent-rgb), 0.1);
  }

  .node-date {
    font-size: 0.65rem;
    opacity: 0.7;
    font-family: monospace;
  }

  .node-score {
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-accent);
  }

  .node-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    border: 2px solid var(--color-card);
    box-shadow: 0 0 0 1px var(--color-accent);
  }
</style>
