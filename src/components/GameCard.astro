---
export interface Props {
  name: string;
  slug: string;
  image: string;
  dataAlpha?: string;
  dataRecent?: number;
  dataScore?: number;
}

const { name, slug, image, dataAlpha, dataRecent, dataScore = 0 } = Astro.props;

const displayDate = dataRecent
  ? new Date(dataRecent).toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "short",
    })
  : "";
---

<li
  class="game-card-container group relative m-0 aspect-[2/3] list-none overflow-hidden rounded-xl bg-neutral-800 shadow-lg transition-all duration-300 hover:-translate-y-2"
  data-alpha={dataAlpha}
  data-recent={dataRecent}
  data-score={dataScore}
>
  <a href={`/games/${slug}/`} class="relative block h-full w-full">
    <div class="sort-metadata absolute top-2 left-2 z-20 flex flex-col gap-1">
      <span
        class="badge-score bg-skin-accent text-skin-fill rounded px-1.5 py-0.5 text-[10px] font-black shadow-md"
      >
        {dataScore > 0 ? dataScore.toFixed(1) : "—"}
      </span>
      <span
        class="badge-date rounded bg-neutral-900/80 px-1.5 py-0.5 text-[10px] font-bold text-white backdrop-blur-sm"
      >
        {displayDate}
      </span>
    </div>
  </a>
  <div
    class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center text-neutral-500"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="mb-2 h-12 w-12 opacity-20"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
      ></path>
    </svg>
    <span
      class="game-card-placeholder-text text-xs font-semibold tracking-wider uppercase"
      >{name}</span
    >
  </div>

  <a href={`/raxplays/games/${slug}/`} class="block h-full w-full">
    <img
      src={`/raxplays${image}`}
      alt=""
      class="absolute inset-0 m-0 h-full w-full object-cover !p-0 transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      onerror="this.style.opacity='0'; this.parentElement.previousElementSibling.style.display='flex';"
    />

    <div
      class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"
    >
    </div>

    <div class="game-card-text-wrapper">
      <h2
        class="!m-0 text-lg leading-tight font-bold text-white transition-colors group-hover:text-accent"
      >
        {name}
      </h2>
    </div>
  </a>
</li>

<style>
  /* Define the container context */
  .game-card-container {
    container-type: inline-size;
    container-name: gamecard;
  }

  /* Position the title wrapper */
  .game-card-text-wrapper {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem;
    pointer-events: none; /* Allows clicks to pass through to the link */
  }

  /* Use :global to break out of Astro's scoping for parent classes */
  :global(#game-grid.show-score) .badge-score {
    display: block !important;
  }

  :global(#game-grid.show-recent) .badge-date {
    display: block !important;
  }

  /* Base styling for the badges (ensures they stay hidden by default) */
  .badge-score,
  .badge-date {
    display: none;
    background: white;
    color: black;
    font-size: 0.9rem;
  }

  /* Hide the text when the card itself is 165px or narrower */
  @container gamecard (max-width: 165px) {
    .game-card-text-wrapper,
    .game-card-placeholder-text {
      display: none !important;
    }
  }
</style>
