---
import { getCollection } from "astro:content";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Card from "@components/Card.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { slugifyStr } from "@utils/slugify";
import { SITE } from "@config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  
  // Get unique games and filter out any undefined ones
  const games = [...new Set(posts.flatMap(post => post.data.games || []))];

  return games.map(game => ({
    params: { game: slugifyStr(game) },
    props: { gameName: game },
  }));
}

const { game } = Astro.params;
const { gameName } = Astro.props;
const posts = await getCollection("blog");

const gamePosts = getSortedPosts(
  posts.filter(post => {
    // 1. Must have the core data object
    if (!post?.data) return false;

    // 2. Must have a title (prevents the 'data' destructuring error)
    if (!post.data.title) return false;

    // 3. Must have a valid game match
    // Check that 'post.data.games' exists and 'game' (from Astro.params) matches
    return post.data.games?.some(g => slugifyStr(g) === game);
  })
);
---

<Layout title={`Game: ${gameName} | ${SITE.title}`}>
  <Header activeNav="games" />
  <Main
    pageTitle={`Game: ${gameName}`}
    pageDesc={`All posts related to ${gameName}.`}
  >
    <ul>
      {gamePosts.map(post => (
        <Card {...post} variant="h2" />
      ))}
    </ul>
  </Main>
  <Footer />
</Layout>