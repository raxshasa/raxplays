---
import { getCollection } from "astro:content";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import { SITE } from "@config";
import { slugifyStr } from "@utils/slugify";
import GameCard from "@components/GameCard.astro";

const posts = await getCollection("blog");

// Get all unique games from all posts
const games = [...new Set(posts.flatMap(post => post.data.games || []))];

const alphabetizedGames = games.sort((a, b) => a.localeCompare(b));
---

<Layout title={`Games | ${SITE.title}`}>
  <Header activeNav="games" />
  <Main pageTitle="Games" pageDesc="All the games I've written about.">
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 mt-8">
      {alphabetizedGames.map(game => (
        <GameCard 
          name={game} 
          slug={slugifyStr(game)} 
          image={`/assets/games/${slugifyStr(game)}.jpg`} 
        />
      ))}
    </ul>
  </Main>
  <Footer />
</Layout>